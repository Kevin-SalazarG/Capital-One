{
  "name": "nessie-node-sdk",
  "version": "0.1.0",
  "description": "Typed Node.js client for the Nessie banking simulation API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevin-SalazarG/nessie-node-sdk.git"
  },
  "homepage": "https://github.com/Kevin-SalazarG/nessie-node-sdk#readme",
  "bugs": {
    "url": "https://github.com/Kevin-SalazarG/nessie-node-sdk/issues"
  },
  "keywords": [
    "nessie",
    "capital-one",
    "sdk",
    "nodejs",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.3",
  "sideEffects": false,
  "main": "./dist/nessie.cjs",
  "module": "./dist/nessie.js",
  "types": "./dist/nessie.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/nessie.d.ts",
        "default": "./dist/nessie.js"
      },
      "require": {
        "types": "./dist/nessie.d.cts",
        "default": "./dist/nessie.cjs"
      }
    },
    "./models/*": {
      "import": {
        "types": "./dist/models/*.d.ts",
        "default": "./dist/models/*.js"
      },
      "require": {
        "types": "./dist/models/*.d.cts",
        "default": "./dist/models/*.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors/nessie-errors.d.ts",
        "default": "./dist/errors/nessie-errors.js"
      },
      "require": {
        "types": "./dist/errors/nessie-errors.d.cts",
        "default": "./dist/errors/nessie-errors.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "docs",
    "spec/nessie-openapi.yaml"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:encoding": "node scripts/check-encoding.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:package": "node scripts/verify-package.mjs",
    "check": "pnpm check:encoding && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:package",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "22.20.2",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
