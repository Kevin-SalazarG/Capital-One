{
  "extends": ["expo/tsconfig.base", "../../tsconfig.base.json"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "types": ["react", "jest", "uniwind/types"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "app.config.ts"],
  "exclude": ["node_modules", "ios", "android", "dist"]
}
