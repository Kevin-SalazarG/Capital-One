# Runtime
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3001
API_PREFIX=api/v1
LOG_LEVEL=info

# Supabase: publishable/secret are preferred. Legacy aliases remain supported.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nessie uses the API host, not the documentation host.
NESSIE_API_KEY=your-nessie-api-key
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
NESSIE_TIMEOUT_MS=10000
NESSIE_MAX_RETRIES=2

# Session cookies
AUTH_ACCESS_COOKIE=colchon_access_token
AUTH_REFRESH_COOKIE=colchon_refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_ACCESS_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=2592000

# Protection
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
